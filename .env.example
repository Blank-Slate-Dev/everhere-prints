# =============================================================================
# Ever Here Prints - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!
# =============================================================================

# =============================================================================
# SECURITY WARNING
# =============================================================================
# ALL variables marked as REQUIRED must be set before deploying to production.
# The application will FAIL TO START if these are not configured.
# This is intentional to prevent security vulnerabilities.
# =============================================================================

# -----------------------------------------------------------------------------
# ADMIN AUTHENTICATION (REQUIRED)
# -----------------------------------------------------------------------------
# Username for admin panel access
# Choose a unique username (DO NOT use "admin" or common usernames)
ADMIN_USERNAME=your_admin_username

# Password for admin panel access
# REQUIRED: Use a strong password meeting these criteria:
#   - Minimum 16 characters
#   - Mixed uppercase and lowercase letters
#   - Include numbers and symbols
#   - Not a dictionary word or common password
# Generate a secure password: https://passwordsgenerator.net/
ADMIN_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION (REQUIRED)
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens
# CRITICAL SECURITY REQUIREMENT:
#   - Must be at least 64 characters
#   - Must be randomly generated
#   - Must be unique per environment
#   - NEVER reuse between staging/production
#
# Generate with Node.js:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Generate with OpenSSL:
#   openssl rand -hex 64
#
JWT_SECRET=your_jwt_secret_here_minimum_64_characters_randomly_generated

# -----------------------------------------------------------------------------
# STRIPE PAYMENT PROCESSING (REQUIRED)
# -----------------------------------------------------------------------------
# Get these from: https://dashboard.stripe.com/apikeys
#
# IMPORTANT: Use TEST keys during development, LIVE keys only in production
# Test keys start with "pk_test_" and "sk_test_"
# Live keys start with "pk_live_" and "sk_live_"

# Publishable key (safe to expose in frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Secret key (NEVER expose in frontend or commit to git)
STRIPE_SECRET_KEY=sk_test_your_secret_key

# -----------------------------------------------------------------------------
# MAPBOX MAPS (REQUIRED)
# -----------------------------------------------------------------------------
# Get your access token from: https://account.mapbox.com/access-tokens/
# Create a token with the following scopes:
#   - styles:read
#   - fonts:read
#   - datasets:read (if using datasets)
#
# TIP: Create separate tokens for development and production
# TIP: Restrict production tokens to your domain for security
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_access_token

# =============================================================================
# OPTIONAL: Production-specific variables
# =============================================================================
# Set these in your Vercel dashboard for production

# Your production domain (used for redirects, meta tags, etc.)
# NEXT_PUBLIC_BASE_URL=https://your-domain.com

# Stripe webhook secret (for receiving payment events)
# Get from: https://dashboard.stripe.com/webhooks
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# SECURITY CHECKLIST BEFORE PRODUCTION DEPLOYMENT
# =============================================================================
# [ ] Generated unique ADMIN_USERNAME (not "admin")
# [ ] Generated strong ADMIN_PASSWORD (16+ chars)
# [ ] Generated random JWT_SECRET (64+ chars)
# [ ] Using Stripe LIVE keys (not test keys)
# [ ] Restricted Mapbox token to production domain
# [ ] Set up Stripe webhooks for order notifications
# [ ] Tested admin login works correctly
# [ ] Verified all environment variables are set in Vercel
# =============================================================================
