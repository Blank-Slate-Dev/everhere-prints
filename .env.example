# =============================================================================
# Ever Here Prints - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# ADMIN AUTHENTICATION
# -----------------------------------------------------------------------------
# Username for admin panel access
# Choose a unique username (not "admin")
ADMIN_USERNAME=your_admin_username

# Password for admin panel access
# IMPORTANT: Use a strong password (min 12 chars, mixed case, numbers, symbols)
# Generate a secure password: https://passwordsgenerator.net/
ADMIN_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens
# CRITICAL: Generate a secure random string (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Or use: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# -----------------------------------------------------------------------------
# STRIPE PAYMENT PROCESSING
# -----------------------------------------------------------------------------
# Get these from: https://dashboard.stripe.com/apikeys

# Publishable key (safe to expose in frontend)
# Starts with "pk_test_" (test mode) or "pk_live_" (production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Secret key (NEVER expose in frontend)
# Starts with "sk_test_" (test mode) or "sk_live_" (production)
STRIPE_SECRET_KEY=sk_test_your_secret_key

# -----------------------------------------------------------------------------
# MAPBOX MAPS
# -----------------------------------------------------------------------------
# Get your access token from: https://account.mapbox.com/access-tokens/
# Create a token with the following scopes:
# - styles:read
# - fonts:read
# - datasets:read (if using datasets)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_access_token

# =============================================================================
# OPTIONAL: Production-specific variables (set in Vercel dashboard)
# =============================================================================
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
